{
  "meta": {
    "name": "Monolithic Technical Interface",
    "version": "2.4.0",
    "brand": "API Scout",
    "description": "Brutalist-Minimalist design system for high-performance API management. Strictly monochromatic, 0px border radius, no shadows except hard-offset on modals. Feels like a premium CLI evolved into a GUI.",
    "philosophy": "Reject decorative excess. Prioritize data density, clarity, and developer utility. Use tonal layering and 1px borders instead of shadows."
  },
  "colors": {
    "primary": {
      "primary": "#000000",
      "onPrimary": "#ffffff",
      "primaryContainer": "#1b1b1b",
      "onPrimaryContainer": "#848484",
      "inversePrimary": "#c6c6c6",
      "primaryFixed": "#e2e2e2",
      "primaryFixedDim": "#c6c6c6",
      "onPrimaryFixed": "#1b1b1b",
      "onPrimaryFixedVariant": "#474747"
    },
    "secondary": {
      "secondary": "#5d5f5f",
      "onSecondary": "#ffffff",
      "secondaryContainer": "#dfe0e0",
      "onSecondaryContainer": "#616363",
      "secondaryFixed": "#e2e2e2",
      "secondaryFixedDim": "#c6c6c7",
      "onSecondaryFixed": "#1a1c1c",
      "onSecondaryFixedVariant": "#454747"
    },
    "tertiary": {
      "tertiary": "#000000",
      "onTertiary": "#ffffff",
      "tertiaryContainer": "#1c1b1b",
      "onTertiaryContainer": "#858383",
      "tertiaryFixed": "#e5e2e1",
      "tertiaryFixedDim": "#c8c6c5",
      "onTertiaryFixed": "#1c1b1b",
      "onTertiaryFixedVariant": "#474746"
    },
    "error": {
      "error": "#ba1a1a",
      "onError": "#ffffff",
      "errorContainer": "#ffdad6",
      "onErrorContainer": "#93000a"
    },
    "surface": {
      "background": "#f9f9f9",
      "onBackground": "#1a1c1c",
      "surface": "#f9f9f9",
      "surfaceDim": "#dadada",
      "surfaceBright": "#f9f9f9",
      "surfaceVariant": "#e2e2e2",
      "surfaceTint": "#5e5e5e",
      "surfaceContainerLowest": "#ffffff",
      "surfaceContainerLow": "#f3f3f3",
      "surfaceContainer": "#eeeeee",
      "surfaceContainerHigh": "#e8e8e8",
      "surfaceContainerHighest": "#e2e2e2",
      "onSurface": "#1a1c1c",
      "onSurfaceVariant": "#4c4546",
      "inverseSurface": "#2f3131",
      "inverseOnSurface": "#f1f1f1"
    },
    "outline": {
      "outline": "#7e7576",
      "outlineVariant": "#cfc4c5"
    },
    "semantic": {
      "success": "#16a34a",
      "successBg": "#dcfce7",
      "successText": "#166534",
      "warning": "#ca8a04",
      "warningBg": "#fef9c3",
      "warningText": "#854d0e",
      "info": "#2563eb",
      "infoBg": "#dbeafe",
      "infoText": "#1e40af",
      "danger": "#dc2626",
      "dangerBg": "#fee2e2",
      "dangerText": "#991b1b",
      "activeBlue": "#0070F3"
    }
  },
  "typography": {
    "fontFamilies": {
      "headline": {
        "name": "Geist",
        "googleFontsUrl": "https://fonts.googleapis.com/css2?family=Geist:wght@400;600;800;900&display=swap",
        "flutterPackage": "google_fonts",
        "fallbacks": ["system-ui", "sans-serif"],
        "flutterImport": "GoogleFonts.geist()"
      },
      "body": {
        "name": "Inter",
        "googleFontsUrl": "https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap",
        "flutterPackage": "google_fonts",
        "fallbacks": ["system-ui", "sans-serif"],
        "flutterImport": "GoogleFonts.inter()"
      },
      "code": {
        "name": "JetBrains Mono",
        "googleFontsUrl": "https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;450;600&display=swap",
        "flutterPackage": "google_fonts",
        "fallbacks": ["SF Mono", "monospace"],
        "flutterImport": "GoogleFonts.jetBrainsMono()"
      }
    },
    "scale": {
      "headlineLg": {
        "family": "Geist",
        "size": 32,
        "weight": 600,
        "lineHeight": 40,
        "letterSpacing": -0.04,
        "usage": "Page titles, hero text"
      },
      "headlineMd": {
        "family": "Geist",
        "size": 24,
        "weight": 600,
        "lineHeight": 32,
        "letterSpacing": -0.03,
        "usage": "Section headers, card titles"
      },
      "headlineSm": {
        "family": "Geist",
        "size": 18,
        "weight": 600,
        "lineHeight": 24,
        "letterSpacing": -0.02,
        "usage": "Subsection headers, modal titles"
      },
      "bodyLg": {
        "family": "Inter",
        "size": 16,
        "weight": 400,
        "lineHeight": 24,
        "letterSpacing": -0.01,
        "usage": "Body text, descriptions"
      },
      "bodyMd": {
        "family": "Inter",
        "size": 14,
        "weight": 400,
        "lineHeight": 20,
        "letterSpacing": 0,
        "usage": "Table cells, form inputs, default text"
      },
      "labelSm": {
        "family": "Inter",
        "size": 12,
        "weight": 600,
        "lineHeight": 16,
        "letterSpacing": 0.05,
        "usage": "Table headers, field labels, filter chips. ALWAYS UPPERCASE."
      },
      "codeMd": {
        "family": "JetBrains Mono",
        "size": 13,
        "weight": 450,
        "lineHeight": 20,
        "letterSpacing": 0,
        "usage": "API keys, endpoints, code blocks, technical data"
      }
    }
  },
  "spacing": {
    "gridUnit": 8,
    "scale": [0, 4, 8, 12, 16, 20, 24, 32, 40, 48, 56, 64],
    "marginMobile": 16,
    "marginDesktop": 32,
    "gutter": 24,
    "containerMaxWidth": 1440,
    "pagePadding": {"horizontal": 32, "vertical": 24},
    "sidebarWidth": 256,
    "topNavHeight": 64
  },
  "borderRadius": {
    "default": 0,
    "note": "ALL elements use 0px border radius. This is a strict rule. Only status dots and avatars may use circles."
  },
  "borders": {
    "structural": {"width": 1, "color": "#e2e2e2", "usage": "Sidebar, cards, table dividers"},
    "focus": {"width": 1, "color": "#000000", "usage": "Input focus state"},
    "highContrast": {"width": 1, "color": "#000000", "usage": "Modal borders, selected states"},
    "selectedRow": {"width": 2, "color": "#000000", "side": "left", "usage": "Table row selection indicator"}
  },
  "shadows": {
    "none": "Default for all elements. Use 1px borders and tonal layering instead.",
    "modalLift": {"offsetX": 4, "offsetY": 4, "blur": 0, "spread": 0, "color": "#000000", "usage": "Modal/dialog cards ONLY"},
    "inputFocus": {"offsetX": 2, "offsetY": 2, "blur": 0, "spread": 0, "color": "#000000", "usage": "Input focus state"},
    "detailPanel": {"offsetX": -4, "offsetY": 0, "blur": 12, "color": "rgba(0,0,0,0.05)", "usage": "Right-side detail panel"}
  },
  "elevation": {
    "level0": {"background": "#ffffff", "usage": "Base canvas"},
    "level1": {"background": "#f3f3f3", "usage": "Sidebar, code blocks, inset wells"},
    "level2": {"background": "#ffffff", "border": "1px #000000", "usage": "Overlays, modals, popovers"}
  },
  "responsive": {
    "breakpoints": {
      "mobile": {"maxWidth": 640, "layout": "single_column", "sidebar": "hidden", "pagePadding": 16},
      "tablet": {"maxWidth": 1024, "layout": "single_column", "sidebar": "collapsed", "pagePadding": 24},
      "desktop": {"minWidth": 1025, "layout": "sidebar_plus_content", "sidebar": "expanded_256px", "pagePadding": 32},
      "wide": {"minWidth": 1440, "layout": "sidebar_plus_content", "maxContentWidth": 1440, "pagePadding": 32}
    },
    "gridSystem": {
      "columns": 12,
      "gutter": 24,
      "margin": {"mobile": 16, "desktop": 32},
      "note": "Use Tailwind-style responsive prefixes: sm: (640px), md: (768px), lg: (1024px), xl: (1280px)"
    },
    "mobileAdaptations": {
      "sidebar": "Bottom navigation bar or hamburger drawer",
      "tables": "Horizontal scroll with sticky first column",
      "detailPanel": "Full-screen overlay instead of right slide-in",
      "modals": "Full-screen on mobile, centered card on desktop",
      "statGrid": "2 columns on mobile, 4 on desktop",
      "topNav": "Compact height (56px) on mobile"
    }
  },
  "accessibility": {
    "contrast": {
      "normalText": {"minRatio": 4.5, "targetRatio": 7},
      "largeText": {"minRatio": 3, "targetRatio": 4.5},
      "uiComponents": {"minRatio": 3, "targetRatio": 4.5}
    },
    "focusManagement": {
      "visible": true,
      "style": {"border": "2px #000000", "offset": 2, "outline": "none"},
      "trapInModals": true,
      "skipLinks": "Skip to main content link at top of page"
    },
    "touchTargets": {
      "minSize": 44,
      "recommendedSize": 48,
      "note": "All interactive elements must be at least 44x44px on mobile"
    },
    "reducedMotion": {
      "enabled": true,
      "fallback": "Instant transitions, no animation, spinner stays static"
    },
    "screenReader": {
      "allImagesHaveAlt": true,
      "formInputsHaveLabels": true,
      "dynamicContentHasLiveRegions": true,
      "modalsHaveAriaLabels": true
    },
    "colorBlindness": {
      "neverUseColorAlone": true,
      "useIconsOrLabels": "Status indicators must have text labels or icons alongside colors",
      "testedWith": ["protanopia", "deuteranopia", "tritanopia"]
    }
  },
  "animations": {
    "globalPrinciples": {
      "respectReducedMotion": true,
      "keepSubtle": "Animations should be functional, not decorative",
      "consistentDuration": "Same type of animation = same duration everywhere"
    },
    "durations": {
      "instant": 0,
      "fast": 150,
      "normal": 200,
      "slow": 300,
      "verySlow": 500
    },
    "easings": {
      "standard": "cubic-bezier(0.4, 0, 0.2, 1)",
      "decelerate": "cubic-bezier(0, 0, 0.2, 1)",
      "accelerate": "cubic-bezier(0.4, 0, 1, 1)",
      "sharp": "cubic-bezier(0.4, 0, 0.6, 1)"
    },
    "transitions": {
      "color": {"property": "color, background-color, border-color", "duration": "200ms", "easing": "standard"},
      "transform": {"property": "transform", "duration": "200ms", "easing": "standard"},
      "opacity": {"property": "opacity", "duration": "150ms", "easing": "standard"},
      "shadow": {"property": "box-shadow", "duration": "200ms", "easing": "standard"},
      "width": {"property": "width, height", "duration": "200ms", "easing": "decelerate"}
    },
    "entrance": {
      "fadeIn": {"opacity": [0, 1], "duration": "200ms"},
      "slideUp": {"opacity": [0, 1], "translateY": [8, 0], "duration": "200ms", "easing": "decelerate"},
      "slideDown": {"opacity": [0, 1], "translateY": [-8, 0], "duration": "200ms", "easing": "decelerate"},
      "scaleIn": {"opacity": [0, 1], "scale": [0.95, 1], "duration": "200ms", "easing": "decelerate"}
    },
    "exit": {
      "fadeOut": {"opacity": [1, 0], "duration": "150ms"},
      "slideOutRight": {"opacity": [1, 0], "translateX": [0, 16], "duration": "200ms", "easing": "accelerate"}
    },
    "spinner": {
      "type": "linear_rotation",
      "duration": "700ms",
      "direction": "clockwise",
      "infinite": true,
      "shape": "square",
      "borderWidth": 2,
      "borderColor": "#e2e2e2",
      "topColor": "transparent",
      "shadow": "1px 1px 0px #000000"
    }
  },
  "iconSystem": {
    "library": "Material Symbols Outlined",
    "url": "https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap",
    "sizes": [16, 18, 20, 24],
    "strokeWidth": 1.5,
    "style": "outline",
    "filledOnly": "Selected/active states",
    "flutterPackage": "material_symbols_icons",
    "usage": {
      "navigation": "16px, outlined",
      "inButtons": "match text size (12px in sm buttons, 14px in default, 16px in lg)",
      "inTables": "16px",
      "statusIcons": "20px, filled for active states",
      "sectionHeaders": "20px, to the left of title text"
    }
  },
  "scrollbar": {
    "trackBackground": "#f9f9f9",
    "trackBorder": "1px solid #e5e5e5",
    "thumb": "#cfc4c5",
    "thumbHover": "#7e7576",
    "width": 8
  },
  " uxPatterns": {
    "loadingStates": {
      "pageLoad": "Full-page spinner centered vertically, 32x32px",
      "tableLoad": "Spinner centered in table body area",
      "buttonLoad": "Replace button text with 16x16px spinner, keep button width",
      "inlineLoad": "Small 12x12px spinner next to text (e.g., 'Creating...')",
      "skeletonLoad": "Pulsing gray blocks matching content shape (optional, not required)"
    },
    "emptyStates": {
      "noData": "Centered message with muted text, no icon needed",
      "noResults": "Search icon + 'No results found' + clear filters button",
      "noItems": "Action button to create first item"
    },
    "errorHandling": {
      "inlineError": "Red text below the field that failed validation",
      "toastError": "Bottom-right toast with hard shadow, auto-dismiss after 5s",
      "pageError": "Full-page error state with retry button",
      "networkError": "Toast with retry action, don't clear current data"
    },
    "successFeedback": {
      "toast": "Bottom-right toast, green background, auto-dismiss after 3s",
      "inline": "Green checkmark or success chip next to the action",
      "pageTransition": "Navigate to the created/updated item"
    },
    "confirmations": {
      "destructive": "Modal dialog with hard shadow, 'Are you sure?' title, cancel + confirm buttons",
      "softDestructive": "Toast with undo action (5s window)",
      "inline": "Double-click or hold-to-confirm for quick toggles"
    },
    "pagination": {
      "style": "Previous / Page numbers / Next",
      "pageSize": 20,
      "showInfo": "'Showing X-Y of Z'",
      "maxVisiblePages": 5
    },
    "search": {
      "debounceMs": 300,
      "minChars": 2,
      "showResults": "Below search input or in main content area",
      "highlightMatches": true
    },
    "detailPanel": {
      "trigger": "Click table row",
      "position": "Right side, overlaying content",
      "width": 384,
      "closeOnBackdropClick": true,
      "closeOnEscape": true,
      "animation": "Slide in from right, 200ms"
    },
    "modals": {
      "backdrop": "White/90 with blur",
      "closeOnBackdropClick": true,
      "closeOnEscape": true,
      "trapFocus": true,
      "returnFocusOnClose": true,
      "animation": "Scale in from 95%, 200ms"
    },
    "toasts": {
      "position": "bottom-right",
      "offset": 20,
      "maxVisible": 3,
      "autoDismiss": {"success": 3000, "error": 5000, "info": 3000},
      "stackDirection": "newest on top",
      "swipeToDismiss": true
    }
  }
}
