<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ renders the system splash from these attributes; without them
         the launcher icon is shown instead of the rounded brand logo. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
    </style>
</resources>
